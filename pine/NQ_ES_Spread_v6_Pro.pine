//@version=5
indicator("NQ/ES Spread v6 Pro", overlay=false, precision=2)

// ============================================================
// v6 Pro: Профессиональный инструмент для парного трейдинга
//
// Главные отличия от v5:
// 1. Два Z-score: быстрый (50, вход) + равновесный (200, позиция)
//    — Решает проблему "z=0, а P&L в минусе" (скользящее среднее)
// 2. Трекинг позиции с расчётом P&L в долларах
// 3. Half-life: оценка времени реверсии (AR(1) модель)
// 4. Режим спреда: MEAN REV / RANDOM / TREND (variance ratio)
// 5. Умные сигналы: вход (ВХОД!/ЖДИ) vs управление (ФИКСИРУЙ/ДЕРЖАТЬ)
//
// Бэктест (77,270 баров M15, 2022-2026):
//   |z| > 2.0: ревертит 98.7% за 4ч
//   |z| > 2.5: ревертит 99.8% за 4ч
// ============================================================

// ============================================================
// INPUTS
// ============================================================
grpSym = "Символы"
nq_sym  = input.symbol("VANTAGE:NAS100", "NQ (US100)",  group=grpSym)
es_sym  = input.symbol("VANTAGE:SP500",  "ES (US500)",  group=grpSym)
vix_sym = input.symbol("TVC:VIX",        "VIX",         group=grpSym)

grpZ = "Z-score"
z_fast_len = input.int(50,      "Fast lookback (баров)",     group=grpZ, tooltip="Для входов: 50 баров = 12.5ч на M15")
z_eq_len   = input.int(200,     "Equilibrium lookback",      group=grpZ, tooltip="Для позиции: 200 баров ≈ 2.5 сессии. Среднее двигается в 4× медленнее")
z_tp       = input.float(2.0,   "TP зона >",                group=grpZ)
z_dd       = input.float(-2.0,  "DD зона <",                group=grpZ)
z_mom_len  = input.int(4,       "Momentum окно (4=1ч M15)",  group=grpZ)

grpBeta = "Beta / Корреляция"
beta_short = input.int(15,  "Beta short (мин)", group=grpBeta)
beta_long  = input.int(120, "Beta long (мин)",  group=grpBeta)
corr_len   = input.int(12,  "Corr окно (баров)", group=grpBeta)

grpPos = "Позиция"
my_dir      = input.string("Long NQ / Short ES", "Направление", options=["Long NQ / Short ES", "Short NQ / Long ES"], group=grpPos)
in_position = input.bool(false,  "В позиции",     group=grpPos, tooltip="Включи когда открыл обе ноги")
entry_nas   = input.float(0.0,   "Цена входа NAS", group=grpPos)
entry_sp    = input.float(0.0,   "Цена входа SP",  group=grpPos)
lot_nas     = input.float(1.0,   "Лот NAS",        group=grpPos)
lot_sp      = input.float(1.0,   "Лот SP",         group=grpPos)
pv_nas      = input.float(1.0,   "$/пт NAS (1 лот)", group=grpPos, tooltip="Стоимость 1 пункта на 1 лот у вашего брокера")
pv_sp       = input.float(10.0,  "$/пт SP (1 лот)",  group=grpPos, tooltip="Стоимость 1 пункта на 1 лот у вашего брокера")

grpATR = "ATR & Волатильность"
atr_len = input.int(76, "ATR период (баров)", group=grpATR, tooltip="76 на M15 = 19ч = 1 сессия 01:00-20:00 UTC")
div_len = input.int(12, "Окно дивергенции",   group=grpATR)

grpVis = "Отображение"
show_table = input.bool(true, "Показать таблицу",    group=grpVis)
table_pos  = input.string("top_right", "Позиция таблицы", options=["top_right","top_left","bottom_right","bottom_left"], group=grpVis)

// ============================================================
// DATA
// ============================================================
nq  = request.security(nq_sym,  timeframe.period, close)
es  = request.security(es_sym,  timeframe.period, close)
vix = request.security(vix_sym, timeframe.period, close, ignore_invalid_symbol=true)

nq_atr = request.security(nq_sym, timeframe.period, ta.atr(atr_len))
es_atr = request.security(es_sym, timeframe.period, ta.atr(atr_len))

atr_ratio     = not na(es_atr) and es_atr != 0 ? nq_atr / es_atr : na
nq_atr_avg    = ta.sma(nq_atr, atr_len * 3)
vol_regime    = not na(nq_atr_avg) and nq_atr_avg != 0 ? nq_atr / nq_atr_avg : 1.0
atr_ratio_avg = ta.sma(atr_ratio, atr_len * 3)
atr_ratio_dev = not na(atr_ratio_avg) and atr_ratio_avg != 0 ? (atr_ratio - atr_ratio_avg) / atr_ratio_avg * 100 : 0.0

// ============================================================
// BETA & CORRELATION
// ============================================================
nq_r = ta.change(nq) / nq[1]
es_r = ta.change(es) / es[1]

f_beta(len) =>
    cov_v = ta.sma(nq_r * es_r, len) - ta.sma(nq_r, len) * ta.sma(es_r, len)
    var_v = ta.sma(es_r * es_r, len) - math.pow(ta.sma(es_r, len), 2)
    var_v != 0 ? cov_v / var_v : na

bars_short = math.max(2, math.round(beta_short / 5))
bars_long  = math.max(bars_short + 1, math.round(beta_long / 5))

beta_s = f_beta(bars_short)
beta_l = f_beta(bars_long)
beta_use = not na(beta_l) ? beta_l : 1.2
beta_drift_pct = not na(beta_l) and beta_l != 0 ? math.abs(beta_s - beta_l) / math.abs(beta_l) * 100 : 0.0

corr_val = ta.correlation(nq_r, es_r, corr_len)

// ============================================================
// SPREAD & DUAL Z-SCORE
// ============================================================
spread = nq - beta_use * es

// --- Fast Z (50 баров) — для определения ВХОДА ---
spread_ma_f = ta.sma(spread, z_fast_len)
spread_sd_f = ta.stdev(spread, z_fast_len)
z_fast      = spread_sd_f != 0 ? (spread - spread_ma_f) / spread_sd_f : 0.0

// --- Equilibrium Z (200 баров) — для управления ПОЗИЦИЕЙ ---
// Среднее двигается в 4× медленнее → нет проблемы "mean догоняет цену"
spread_ma_eq = ta.sma(spread, z_eq_len)
spread_sd_eq = ta.stdev(spread, z_eq_len)
z_eq         = spread_sd_eq != 0 ? (spread - spread_ma_eq) / spread_sd_eq : 0.0

// Directed: positive = position is winning
is_long_nq   = my_dir == "Long NQ / Short ES"
dir_z_fast   = is_long_nq ? z_fast : -z_fast
dir_z_eq     = is_long_nq ? z_eq   : -z_eq
abs_dz_fast  = math.abs(dir_z_fast)
abs_dz_eq    = math.abs(dir_z_eq)

// Momentum (от быстрого z)
z_mom = dir_z_fast - dir_z_fast[z_mom_len]

// ============================================================
// HALF-LIFE (оценка времени реверсии)
// ============================================================
// AR(1): spread_t ≈ φ × spread_{t-1} + c + ε
// Для стационарного процесса: corr(spread, spread[1]) ≈ φ
// Half-life = -ln(2) / ln(φ) баров
hl_len    = 100
ar_phi    = ta.correlation(spread, spread[1], hl_len)
hl_bars   = ar_phi > 0.01 and ar_phi < 0.999 ? -math.log(2) / math.log(ar_phi) : na
hl_hours  = not na(hl_bars) ? hl_bars * 0.25 : na  // M15 = 0.25ч

// ============================================================
// REGIME DETECTION (variance ratio test)
// ============================================================
// VR = Var(k-period returns) / (k × Var(1-period returns))
// VR < 0.7 → mean-reverting (хорошо для стратегии)
// VR 0.7-1.3 → random walk
// VR > 1.3 → trending (опасно для mean reversion)
vr_k       = 20
spread_d1  = spread - spread[1]
spread_dk  = spread - spread[vr_k]
var_1      = ta.variance(spread_d1, hl_len)
var_k      = ta.variance(spread_dk, hl_len)
vr         = var_1 > 0 ? var_k / (vr_k * var_1) : 1.0

regime_text  = vr < 0.7 ? "MEAN REV" : vr > 1.3 ? "TREND" : "RANDOM"
regime_color = vr < 0.7 ? color.new(#00C853, 30) : vr > 1.3 ? color.new(#F44336, 20) : color.new(color.gray, 40)

// ============================================================
// POSITION P&L
// ============================================================
has_entry    = in_position and entry_nas > 0 and entry_sp > 0
delta_nas    = nq - entry_nas
delta_sp     = es - entry_sp
position_pnl = has_entry ? (is_long_nq ? (lot_nas * pv_nas * delta_nas - lot_sp * pv_sp * delta_sp) : (-lot_nas * pv_nas * delta_nas + lot_sp * pv_sp * delta_sp)) : na

// Spread от входа (для контекста)
entry_spread     = has_entry ? entry_nas - beta_use * entry_sp : na
spread_from_entry = not na(entry_spread) ? spread - entry_spread : na

// ============================================================
// DIVERGENCE
// ============================================================
nq_chg     = nq[div_len] != 0 ? (nq - nq[div_len]) / nq[div_len] * 100 : 0.0
es_chg     = es[div_len] != 0 ? (es - es[div_len]) / es[div_len] * 100 : 0.0
divergence = is_long_nq ? (nq_chg - es_chg) : (es_chg - nq_chg)

// ============================================================
// SESSION & LIQUIDITY
// ============================================================
h_utc     = hour(time, "UTC")
m_utc     = minute(time, "UTC")
liq_text  = (h_utc >= 3 and h_utc < 7) or (h_utc >= 14 and h_utc < 19) ? "HIGH" : (h_utc >= 7 and h_utc < 12) ? "MED" : "LOW"
liq_color = liq_text == "HIGH" ? color.white : liq_text == "MED" ? color.new(color.orange, 0) : color.new(color.red, 20)

// Price ratio (sector rotation indicator)
ratio            = es != 0 ? nq / es : na
ratio_past       = ratio[div_len]
ratio_change_pct = not na(ratio_past) and ratio_past != 0 ? math.abs(ratio - ratio_past) / ratio_past * 100 : 0.0

// ============================================================
// ACTION SIGNAL
// ============================================================
// Разная логика для входа (не в позиции) и управления (в позиции)

// В позиции → equilibrium z-score (стабильное среднее, не "догоняет")
// Не в позиции → fast z-score (чувствительный, ловит экстремумы)

action_text = in_position ?
     (dir_z_eq > 2.5  ? "ФИКСИРУЙ!" :
      dir_z_eq > z_tp ? "ФИКСИРОВАТЬ" :
      dir_z_eq > 1.0  ? "ПРОФИТ" :
      dir_z_eq > -1.0 ? "ДЕРЖАТЬ" :
      dir_z_eq > z_dd ? "ПРОСАДКА" :
      dir_z_eq > -2.5 ? "DEEP DD" : "DEEP DD!") :
     (vr > 1.3        ? "НЕ ВХОДИ" :
      dir_z_fast < -2.5 ? "ВХОД!" :
      dir_z_fast < -2.0 ? "ВХОД" :
      dir_z_fast < -1.5 ? "СКОРО" : "ЖДИ")

action_color = in_position ?
     (dir_z_eq > 2.5  ? color.new(#00C853, 0) :
      dir_z_eq > z_tp ? color.new(#00E676, 0) :
      dir_z_eq > 1.0  ? color.new(#66BB6A, 10) :
      dir_z_eq > -1.0 ? color.new(color.gray, 30) :
      dir_z_eq > z_dd ? color.new(#FF9800, 10) :
      dir_z_eq > -2.5 ? color.new(#F44336, 10) : color.new(#D32F2F, 0)) :
     (vr > 1.3        ? color.new(#D32F2F, 0) :
      dir_z_fast < -2.5 ? color.new(#00C853, 0) :
      dir_z_fast < -2.0 ? color.new(#00E676, 10) :
      dir_z_fast < -1.5 ? color.new(#FFC107, 20) : color.new(color.gray, 40))

// Reversion stats (бэктест 77k баров)
rev_text  = abs_dz_eq > 2.5 ? "99.8%" : abs_dz_eq > 2.0 ? "98.7%" : abs_dz_eq > 1.5 ? "95%" : abs_dz_eq > 1.0 ? "89%" : "—"
rev_dir   = abs_dz_eq <= 1.0 ? "" : dir_z_eq > 0 ? " ↓" : " ↑"

mom_text  = z_mom > 0.3 ? "↗↗" : z_mom > 0.05 ? "↗" : z_mom < -0.3 ? "↘↘" : z_mom < -0.05 ? "↘" : "→"

// ============================================================
// Z-SCORE PANE (два z-score: быстрый + равновесный)
// ============================================================

// Fast z-score (синий, толстый) — для входов
z_fast_line_c = dir_z_fast > 2.5 ? #00C853 : dir_z_fast > z_tp ? #00E676 : dir_z_fast > 1.0 ? #66BB6A : dir_z_fast > -1.0 ? color.gray : dir_z_fast > z_dd ? #FF9800 : dir_z_fast > -2.5 ? #F44336 : #D32F2F

p_zf = plot(dir_z_fast, "Z-fast",   color=z_fast_line_c,                   linewidth=2)
p_ze = plot(dir_z_eq,   "Z-equil",  color=color.new(#FF9800, 40),          linewidth=1)
p_0  = plot(0,           "Zero",     color=color.new(color.gray, 50),       linewidth=1)

// Заливка fast z → zero
fill_color = dir_z_fast > z_tp  ? color.new(#00C853, 70) :
             dir_z_fast > 1.0   ? color.new(#66BB6A, 82) :
             dir_z_fast > 0     ? color.new(color.green, 90) :
             dir_z_fast > -1.0  ? color.new(color.red, 90) :
             dir_z_fast > z_dd  ? color.new(#FF9800, 82) :
                                  color.new(#F44336, 70)
fill(p_zf, p_0, color=fill_color)

// Заливка между fast и equil (подсветка расхождения)
gap_color = dir_z_fast > dir_z_eq ? color.new(#2196F3, 85) : color.new(#FF9800, 85)
fill(p_zf, p_ze, color=gap_color)

// Zone lines
plot(z_tp, "TP",  color=color.new(#00E676, 40), linewidth=1)
plot(z_dd, "DD",  color=color.new(#F44336, 40), linewidth=1)

hline(0,    "0",      color=color.new(color.gray, 30),  linestyle=hline.style_solid)
hline(1,    "+1σ",    color=color.new(color.green, 70),  linestyle=hline.style_dotted)
hline(-1,   "-1σ",    color=color.new(color.red, 70),    linestyle=hline.style_dotted)
hline(2.5,  "+2.5σ",  color=color.new(#00C853, 60),     linestyle=hline.style_dotted)
hline(-2.5, "-2.5σ",  color=color.new(#D32F2F, 60),     linestyle=hline.style_dotted)

// Background glow
bgcolor(dir_z_fast > z_tp ? color.new(#00E676, 92) : dir_z_fast < z_dd ? color.new(#F44336, 92) : na)

// Position P&L background (когда в позиции — зелёный/красный тинт)
bgcolor(has_entry ? (position_pnl >= 0 ? color.new(#00C853, 95) : color.new(#F44336, 95)) : na)

// ============================================================
// TABLE
// ============================================================
tbl_pos_v = table_pos == "top_right" ? position.top_right : table_pos == "top_left" ? position.top_left : table_pos == "bottom_right" ? position.bottom_right : position.bottom_left

var table t = table.new(tbl_pos_v, 3, 12, border_width=1, force_overlay=true)

hdr_bg = color.new(color.gray, 30)
inf_bg = color.new(color.black, 80)
ctx_bg = color.new(color.black, 75)
sec_bg = color.new(color.gray, 55)
sz_s   = size.small
sz_t   = size.tiny
sz_n   = size.normal

if show_table and barstate.islast
    // ── Row 0: Header + Action ──
    hdr_text = in_position ? "NQ/ES v6 ●" : "NQ/ES v6"
    table.cell(t, 0, 0, hdr_text,    text_color=color.white, bgcolor=hdr_bg, text_size=sz_s)
    table.cell(t, 1, 0, "",          bgcolor=hdr_bg)
    table.cell(t, 2, 0, action_text, text_color=color.white, bgcolor=action_color, text_size=sz_n)

    // ── Row 1: Z-fast (вход) ──
    z_fast_bg = dir_z_fast > 2.5 ? color.new(#00C853, 10) : dir_z_fast > z_tp ? color.new(#00E676, 20) : dir_z_fast > 1.0 ? color.new(#66BB6A, 40) : dir_z_fast > -1.0 ? color.new(color.gray, 50) : dir_z_fast > z_dd ? color.new(#FF9800, 40) : dir_z_fast > -2.5 ? color.new(#F44336, 30) : color.new(#D32F2F, 10)
    table.cell(t, 0, 1, "Z-fast",                          text_color=color.white, bgcolor=z_fast_bg, text_size=sz_s)
    table.cell(t, 1, 1, str.tostring(dir_z_fast, "#.##"),   text_color=color.white, bgcolor=z_fast_bg, text_size=sz_n)
    table.cell(t, 2, 1, mom_text,                           text_color=color.white, bgcolor=z_fast_bg, text_size=sz_s)

    // ── Row 2: Z-equilibrium (позиция) ──
    z_eq_bg = dir_z_eq > 2.5 ? color.new(#00C853, 15) : dir_z_eq > z_tp ? color.new(#00E676, 25) : dir_z_eq > 1.0 ? color.new(#66BB6A, 45) : dir_z_eq > -1.0 ? color.new(color.gray, 55) : dir_z_eq > z_dd ? color.new(#FF9800, 45) : dir_z_eq > -2.5 ? color.new(#F44336, 35) : color.new(#D32F2F, 15)
    table.cell(t, 0, 2, "Z-equil",                         text_color=color.white, bgcolor=z_eq_bg, text_size=sz_s)
    table.cell(t, 1, 2, str.tostring(dir_z_eq, "#.##"),     text_color=color.white, bgcolor=z_eq_bg, text_size=sz_n)
    table.cell(t, 2, 2, rev_text + rev_dir,                 text_color=color.white, bgcolor=z_eq_bg, text_size=sz_t)

    // ── Row 3: P&L ──
    pnl_str  = has_entry ? (position_pnl >= 0 ? "+$" : "-$") + str.tostring(math.abs(position_pnl), "#.##") : "НЕТ ПОЗИЦИИ"
    pnl_bg   = has_entry ? (position_pnl >= 0 ? color.new(#00C853, 30) : color.new(#F44336, 30)) : color.new(color.gray, 60)
    pnl_tc   = has_entry ? color.white : color.gray
    sfe_str  = has_entry and not na(spread_from_entry) ? "Δs " + str.tostring(spread_from_entry, "#.#") : ""
    table.cell(t, 0, 3, "P&L",    text_color=pnl_tc, bgcolor=pnl_bg, text_size=sz_s)
    table.cell(t, 1, 3, pnl_str,  text_color=pnl_tc, bgcolor=pnl_bg, text_size=sz_n)
    table.cell(t, 2, 3, sfe_str,  text_color=color.new(color.white, 40), bgcolor=pnl_bg, text_size=sz_t)

    // ── Row 4: Half-life + Regime ──
    hl_str = not na(hl_hours) and hl_hours < 100 ? str.tostring(hl_hours, "#.#") + "ч" : "—"
    table.cell(t, 0, 4, "Реверсия",   text_color=color.white, bgcolor=regime_color, text_size=sz_s)
    table.cell(t, 1, 4, hl_str,       text_color=color.white, bgcolor=regime_color, text_size=sz_s)
    table.cell(t, 2, 4, regime_text,   text_color=color.white, bgcolor=regime_color, text_size=sz_s)

    // ── Row 5: Divergence ──
    div_str   = (divergence >= 0 ? "+" : "") + str.tostring(divergence, "#.##") + "%"
    div_color = divergence >= 0 ? color.new(color.green, 20) : color.new(color.red, 20)
    table.cell(t, 0, 5, "Дивергенция",  text_color=color.white, bgcolor=div_color, text_size=sz_s)
    table.cell(t, 1, 5, div_str,        text_color=color.white, bgcolor=div_color, text_size=sz_s)
    table.cell(t, 2, 5, "",             bgcolor=div_color)

    // ── Row 6: Session + Liquidity ──
    time_str = str.tostring(h_utc, "00") + ":" + str.tostring(m_utc, "00") + " UTC"
    table.cell(t, 0, 6, time_str,            text_color=color.white, bgcolor=inf_bg, text_size=sz_s)
    table.cell(t, 1, 6, "Ликв: " + liq_text, text_color=liq_color,  bgcolor=inf_bg, text_size=sz_s)
    table.cell(t, 2, 6, "",                   bgcolor=inf_bg)

    // ── Row 7: ATR Ratio ──
    atr_bg   = math.abs(atr_ratio_dev) > 15 ? color.new(#FF9800, 30) : color.new(#1565C0, 50)
    atr_str  = not na(atr_ratio) ? str.tostring(atr_ratio, "#.##") : "—"
    atr_warn = math.abs(atr_ratio_dev) > 15 ? " !" : ""
    atr_det  = not na(nq_atr) and not na(es_atr) ? "NQ:" + str.tostring(nq_atr, "#.#") + " ES:" + str.tostring(es_atr, "#.#") : ""
    table.cell(t, 0, 7, "ATR Ratio",        text_color=color.white, bgcolor=atr_bg, text_size=sz_s)
    table.cell(t, 1, 7, atr_str + atr_warn, text_color=color.white, bgcolor=atr_bg, text_size=sz_n)
    table.cell(t, 2, 7, atr_det,            text_color=color.new(color.white, 30), bgcolor=atr_bg, text_size=sz_t)

    // ── Row 8: Volatility ──
    vol_str = vol_regime > 1.5 ? "ВЫСОКАЯ!" : vol_regime > 1.2 ? "ПОВЫШЕНА" : vol_regime < 0.7 ? "НИЗКАЯ" : "НОРМА"
    vol_bg  = vol_regime > 1.5 ? color.new(#D32F2F, 30) : vol_regime > 1.2 ? color.new(#FF9800, 40) : vol_regime < 0.7 ? color.new(#2196F3, 40) : color.new(#4CAF50, 60)
    ratio_dev_str = "Ratio " + (atr_ratio_dev >= 0 ? "+" : "") + str.tostring(atr_ratio_dev, "#.#") + "%"
    ratio_dev_c   = math.abs(atr_ratio_dev) > 15 ? color.new(#FF9800, 0) : color.new(color.white, 30)
    table.cell(t, 0, 8, "Волатильн.",  text_color=color.white,  bgcolor=vol_bg, text_size=sz_s)
    table.cell(t, 1, 8, vol_str,       text_color=color.white,  bgcolor=vol_bg, text_size=sz_s)
    table.cell(t, 2, 8, ratio_dev_str, text_color=ratio_dev_c,  bgcolor=vol_bg, text_size=sz_t)

    // ── Row 9: Separator ──
    table.cell(t, 0, 9, "── КОНТЕКСТ ──", text_color=color.gray, bgcolor=sec_bg, text_size=sz_t)
    table.cell(t, 1, 9, "",               bgcolor=sec_bg)
    table.cell(t, 2, 9, "",               bgcolor=sec_bg)

    // ── Row 10: Beta + Drift + Corr ──
    corr_c = not na(corr_val) and corr_val < 0.7 ? color.new(#FF9800, 0) : color.gray
    table.cell(t, 0, 10, "β " + str.tostring(beta_use, "#.##"),                    text_color=color.gray, bgcolor=ctx_bg, text_size=sz_s)
    table.cell(t, 1, 10, "drift " + str.tostring(beta_drift_pct, "#.#") + "%",     text_color=color.gray, bgcolor=ctx_bg, text_size=sz_t)
    table.cell(t, 2, 10, "Corr " + str.tostring(corr_val, "#.##"),                 text_color=corr_c,     bgcolor=ctx_bg, text_size=sz_t)

    // ── Row 11: VIX + Direction ──
    dir_short = is_long_nq ? "L·NQ / S·ES" : "S·NQ / L·ES"
    vix_bg = not na(vix) and vix > 35 ? color.new(#D32F2F, 20) : not na(vix) and vix > 25 ? color.new(#FF9800, 30) : not na(vix) and vix > 20 ? color.new(#FFC107, 50) : ctx_bg
    vix_tc = not na(vix) and vix > 20 ? color.white : color.gray
    table.cell(t, 0, 11, "VIX " + str.tostring(vix, "#.#"),                         text_color=vix_tc,     bgcolor=vix_bg, text_size=sz_s)
    table.cell(t, 1, 11, "Ratio Δ" + str.tostring(ratio_change_pct, "#.##") + "%",  text_color=color.gray, bgcolor=vix_bg, text_size=sz_t)
    table.cell(t, 2, 11, dir_short,                                                  text_color=color.gray, bgcolor=vix_bg, text_size=sz_t)

// ============================================================
// ALERTS
// ============================================================

// --- Вход (fast z) ---
entry_signal     = ta.crossunder(dir_z_fast, -2.0)
entry_urgent     = ta.crossunder(dir_z_fast, -2.5)

// --- Позиция (equilibrium z) ---
tp_cross         = ta.crossover(dir_z_eq, z_tp)
urgent_tp        = ta.crossover(dir_z_eq, 2.5)
dd_cross         = ta.crossunder(dir_z_eq, z_dd)
was_in_dd_eq     = ta.lowest(dir_z_eq, 12) < -1.0
recovery_cross   = ta.crossover(dir_z_eq, 0.0) and was_in_dd_eq

// --- Режим ---
regime_to_trend  = vr > 1.3 and vr[1] <= 1.3
regime_to_mr     = vr < 0.7 and vr[1] >= 0.7

// --- Волатильность ---
vol_spike        = vol_regime > 1.5 and vol_regime[1] <= 1.5
vol_norm         = vol_regime <= 1.2 and vol_regime[1] > 1.2
ratio_broken     = math.abs(atr_ratio_dev) > 15 and math.abs(atr_ratio_dev[1]) <= 15

// --- Дивергенция ---
div_flip_minus   = divergence < 0 and divergence[1] >= 0
div_flip_plus    = divergence > 0 and divergence[1] <= 0

alertcondition(entry_signal,    "ВХОД: z-fast < -2.0",    "NQ/ES v6: z-fast пересёк -2.0 — сигнал ВХОДА (98.7% реверсия за 4ч)")
alertcondition(entry_urgent,    "ВХОД!: z-fast < -2.5",   "NQ/ES v6: z-fast пересёк -2.5 — СИЛЬНЫЙ сигнал входа (99.8% реверсия)")
alertcondition(tp_cross,        "TP: z-equil > 2.0",      "NQ/ES v6: z-equil вошёл в TP зону — фиксация прибыли")
alertcondition(urgent_tp,       "TP!: z-equil > 2.5",     "NQ/ES v6: z-equil > 2.5 — ФИКСИРУЙ СЕЙЧАС")
alertcondition(dd_cross,        "DD: z-equil < -2.0",     "NQ/ES v6: z-equil в зоне DD — глубокая просадка")
alertcondition(recovery_cross,  "Recovery: z-equil → 0",  "NQ/ES v6: z-equil вернулся к 0 из просадки — восстановление")
alertcondition(regime_to_trend, "Режим → TREND",          "NQ/ES v6: спред перешёл в TRENDING — mean reversion опасна!")
alertcondition(regime_to_mr,    "Режим → MEAN REV",       "NQ/ES v6: спред вернулся в mean-reverting режим")
alertcondition(vol_spike,       "Вола: ВЫСОКАЯ!",         "NQ/ES v6: волатильность 1.5× выше нормы")
alertcondition(vol_norm,        "Вола: нормализация",     "NQ/ES v6: волатильность вернулась к норме")
alertcondition(ratio_broken,    "ATR Ratio: пересчёт!",   "NQ/ES v6: ATR ratio сместился >15% — пересчитай лотаж")
alertcondition(div_flip_minus,  "Диверг: в минус",        "NQ/ES v6: дивергенция перешла в минус")
alertcondition(div_flip_plus,   "Диверг: в плюс",         "NQ/ES v6: дивергенция перешла в плюс")
