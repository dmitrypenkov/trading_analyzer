//@version=5
indicator("NAS100/GER40 Spread Monitor v1", overlay=false, precision=2)

// ============================================================
// v1: Парный трейдинг NAS100/GER40 (корреляция +0.66)
//
// Бэктест (77,200 баров, 2022-2026):
//   |z| > 1.5: ревертит 78.8% за 4ч
//   |z| > 2.0: ревертит 95.8% за 4ч
//   |z| > 2.5: ревертит 99.9% за 4ч
//   ВНИМАНИЕ: корреляция нестабильна (0.58-0.73 по годам)
//   Торгуй ТОЛЬКО в overlap 13:30-16:30 UTC (обе биржи активны)
// ============================================================

// ============================================================
// INPUTS
// ============================================================
grpSym = "Символы"
nq_sym  = input.symbol("VANTAGE:NAS100", "NAS100",  group=grpSym)
dax_sym = input.symbol("VANTAGE:GER40",  "GER40 (DAX)", group=grpSym)
vix_sym = input.symbol("TVC:VIX",        "VIX",     group=grpSym)

grpZ = "Z-score (главный сигнал)"
zscore_len = input.int(50,     "Lookback (баров)",            group=grpZ)
z_tp       = input.float(2.5,  "Зона Take Profit >",         group=grpZ, tooltip="Выше чем NQ/ES из-за более слабой корреляции")
z_dd       = input.float(-2.5, "Зона Deep Drawdown <",       group=grpZ)
z_mom_len  = input.int(4,      "Momentum окно (4 бара = 1ч)", group=grpZ)

grpCalc = "Расчёт Beta/Corr"
beta_short = input.int(15,  "Beta short (мин)",      group=grpCalc)
beta_long  = input.int(120, "Beta long (мин)",       group=grpCalc)
corr_len   = input.int(12,  "Corr окно (баров)",     group=grpCalc)
sector_len = input.int(12,  "Ratio окно (баров)",    group=grpCalc)

grpPos = "Моя позиция"
my_dir  = input.string("Long NAS100 / Short GER40", "Направление", options=["Long NAS100 / Short GER40", "Short NAS100 / Long GER40"], group=grpPos)
div_len = input.int(12, "Окно дивергенции (баров)", group=grpPos)

grpVis = "Отображение"
show_table = input.bool(true, "Показать таблицу",    group=grpVis)
table_pos  = input.string("top_right", "Позиция таблицы", options=["top_right","top_left","bottom_right","bottom_left","middle_right"], group=grpVis)

grpATR = "ATR Ratio (лотаж)"
atr_len = input.int(76, "ATR период (баров)", group=grpATR, tooltip="На M15: 76 = 1 сессия (19ч)")

// ============================================================
// DATA
// ============================================================
nq  = request.security(nq_sym,  timeframe.period, close)
dax = request.security(dax_sym, timeframe.period, close)
vix = request.security(vix_sym, timeframe.period, close, ignore_invalid_symbol=true)

nq_atr  = request.security(nq_sym,  timeframe.period, ta.atr(atr_len))
dax_atr = request.security(dax_sym, timeframe.period, ta.atr(atr_len))
atr_ratio = not na(dax_atr) and dax_atr != 0 ? nq_atr / dax_atr : na

// Volatility regime
nq_atr_avg = ta.sma(nq_atr, atr_len * 3)
vol_regime = not na(nq_atr_avg) and nq_atr_avg != 0 ? nq_atr / nq_atr_avg : 1.0

// ATR ratio stability
atr_ratio_avg = ta.sma(atr_ratio, atr_len * 3)
atr_ratio_dev = not na(atr_ratio_avg) and atr_ratio_avg != 0 ? (atr_ratio - atr_ratio_avg) / atr_ratio_avg * 100 : 0.0

bars_short = math.max(2, math.round(beta_short / 5))
bars_long  = math.max(bars_short + 1, math.round(beta_long / 5))

// ============================================================
// CALCULATIONS
// ============================================================
nq_r  = ta.change(nq) / nq[1]
dax_r = ta.change(dax) / dax[1]

f_beta(len) =>
    cov_v = ta.sma(nq_r * dax_r, len) - ta.sma(nq_r, len) * ta.sma(dax_r, len)
    var_v = ta.sma(dax_r * dax_r, len) - math.pow(ta.sma(dax_r, len), 2)
    var_v != 0 ? cov_v / var_v : na

beta_s = f_beta(bars_short)
beta_l = f_beta(bars_long)
beta_drift_pct = not na(beta_l) and beta_l != 0 ? math.abs(beta_s - beta_l) / math.abs(beta_l) * 100 : 0.0

corr_val = ta.correlation(nq_r, dax_r, corr_len)

// NAS/DAX price ratio
ratio            = dax != 0 ? nq / dax : na
ratio_past       = ratio[sector_len]
ratio_change_pct = not na(ratio_past) and ratio_past != 0 ? math.abs(ratio - ratio_past) / ratio_past * 100 : 0.0

vix_past      = vix[3]
vix_spike_pct = not na(vix_past) and vix_past != 0 ? (vix - vix_past) / vix_past * 100 : 0.0

// ============================================================
// Z-SCORE — PRIMARY SIGNAL
// ============================================================
beta_use  = not na(beta_l) ? beta_l : 0.86
spread    = nq - beta_use * dax
spread_ma = ta.sma(spread, zscore_len)
spread_sd = ta.stdev(spread, zscore_len)
zscore    = spread_sd != 0 ? (spread - spread_ma) / spread_sd : 0.0

dir_z = my_dir == "Long NAS100 / Short GER40" ? zscore : -zscore
abs_dz = math.abs(dir_z)

z_mom = dir_z - dir_z[z_mom_len]

// ============================================================
// SESSION OVERLAP — КРИТИЧЕСКИ ВАЖНО ДЛЯ ЭТОЙ ПАРЫ
// ============================================================
h_utc = hour(time, "UTC")
m_utc = minute(time, "UTC")
// GER40 main: 07:00-16:30 UTC, NAS100 main: 13:30-20:00 UTC
is_overlap  = (h_utc == 13 and m_utc >= 30) or (h_utc >= 14 and h_utc < 16) or (h_utc == 16 and m_utc < 30)
is_dax_only = (h_utc >= 7 and h_utc < 13) or (h_utc == 13 and m_utc < 30)
is_nq_only  = (h_utc == 16 and m_utc >= 30) or (h_utc >= 17 and h_utc < 20)

liq_text  = is_overlap ? "OVERLAP" : is_dax_only ? "DAX only" : is_nq_only ? "NAS only" : "CLOSED"
liq_color = is_overlap ? color.white : (is_dax_only or is_nq_only) ? color.new(color.orange, 0) : color.new(color.red, 20)

// ============================================================
// ACTION SIGNAL
// ============================================================
// При отсутствии overlap — добавить предупреждение
overlap_warn = is_overlap ? "" : " ⚠"
action_text = dir_z > 2.5 ? "ФИКСИРУЙ!" : dir_z > z_tp ? "ФИКСИРОВАТЬ" : dir_z > 1.0 ? "ПРОФИТ" : dir_z > -1.0 ? "НЕЙТРАЛЬНО" : dir_z > z_dd ? "ПРОСАДКА" : dir_z > -2.5 ? "DEEP DD" : "DEEP DD!"
action_color = dir_z > 2.5 ? color.new(#00C853, 0) : dir_z > z_tp ? color.new(#00E676, 0) : dir_z > 1.0 ? color.new(#66BB6A, 10) : dir_z > -1.0 ? color.new(color.gray, 30) : dir_z > z_dd ? color.new(#FF9800, 10) : dir_z > -2.5 ? color.new(#F44336, 10) : color.new(#D32F2F, 0)

// Reversion stats (BACKTESTED on 77k bars) — слабее чем NQ/ES!
rev_text   = abs_dz > 2.5 ? "99.9%" : abs_dz > 2.0 ? "95.8%" : abs_dz > 1.5 ? "79%" : abs_dz > 1.0 ? "~65%" : "—"
rev_detail = abs_dz > 1.0 ? " за 4ч" : ""
rev_dir    = abs_dz <= 1.0 ? "" : dir_z > 0 ? "↓ к сред." : "↑ к сред."

mom_text = z_mom > 0.3 ? "↗↗" : z_mom > 0.05 ? "↗" : z_mom < -0.3 ? "↘↘" : z_mom < -0.05 ? "↘" : "→"

// Divergence
nq_chg     = nq[div_len] != 0 ? (nq - nq[div_len]) / nq[div_len] * 100 : 0.0
dax_chg    = dax[div_len] != 0 ? (dax - dax[div_len]) / dax[div_len] * 100 : 0.0
divergence = my_dir == "Long NAS100 / Short GER40" ? (nq_chg - dax_chg) : (dax_chg - nq_chg)
div_text   = (divergence >= 0 ? "+" : "") + str.tostring(divergence, "#.##") + "%"
div_color  = divergence >= 0 ? color.new(color.green, 20) : color.new(color.red, 20)

// ============================================================
// Z-SCORE PANE
// ============================================================
z_line_color = dir_z > 2.5 ? #00C853 : dir_z > z_tp ? #00E676 : dir_z > 1.0 ? #66BB6A : dir_z > -1.0 ? color.gray : dir_z > z_dd ? #FF9800 : dir_z > -2.5 ? #F44336 : #D32F2F

p_z = plot(dir_z, "Z-score", color=z_line_color, linewidth=2)
p_0 = plot(0,     "Zero",    color=color.new(color.gray, 50), linewidth=1)

fill_color = dir_z > z_tp   ? color.new(#00C853, 70) :
             dir_z > 1.0    ? color.new(#66BB6A, 82) :
             dir_z > 0      ? color.new(color.green, 90) :
             dir_z > -1.0   ? color.new(color.red, 90) :
             dir_z > z_dd   ? color.new(#FF9800, 82) :
                              color.new(#F44336, 70)
fill(p_z, p_0, color=fill_color)

plot(z_tp, "TP зона", color=color.new(#00E676, 40), linewidth=1)
plot(z_dd, "DD зона", color=color.new(#F44336, 40), linewidth=1)

hline(0,    "0",      color=color.new(color.gray, 30),  linestyle=hline.style_solid)
hline(1,    "+1σ",    color=color.new(color.green, 70),  linestyle=hline.style_dotted)
hline(-1,   "-1σ",    color=color.new(color.red, 70),    linestyle=hline.style_dotted)
hline(2.5,  "+2.5σ",  color=color.new(#00C853, 60),     linestyle=hline.style_dotted)
hline(-2.5, "-2.5σ",  color=color.new(#D32F2F, 60),     linestyle=hline.style_dotted)

// Фон: зоны TP/DD + затемнение вне overlap
overlap_dim = is_overlap ? na : color.new(#1A1A2E, 85)
bgcolor(dir_z > z_tp ? color.new(#00E676, 92) : dir_z < z_dd ? color.new(#F44336, 92) : overlap_dim)

// ============================================================
// TABLE
// ============================================================
tbl_pos_v = table_pos == "top_right" ? position.top_right : table_pos == "top_left" ? position.top_left : table_pos == "bottom_right" ? position.bottom_right : table_pos == "bottom_left" ? position.bottom_left : position.middle_right

var table t = table.new(tbl_pos_v, 3, 10, border_width=1, force_overlay=true)

hdr_bg = color.new(color.gray, 30)
inf_bg = color.new(color.black, 80)
ctx_bg = color.new(color.black, 75)
sec_bg = color.new(color.gray, 55)
z_cell = dir_z > 2.5 ? color.new(#00C853, 10) : dir_z > z_tp ? color.new(#00E676, 20) : dir_z > 1.0 ? color.new(#66BB6A, 40) : dir_z > -1.0 ? color.new(color.gray, 50) : dir_z > z_dd ? color.new(#FF9800, 40) : dir_z > -2.5 ? color.new(#F44336, 30) : color.new(#D32F2F, 10)
sz_s   = size.small
sz_t   = size.tiny
sz_n   = size.normal

if show_table and barstate.islast
    // Row 0: Title + Action (предупреждение вне overlap)
    title_bg = is_overlap ? hdr_bg : color.new(#B71C1C, 40)
    title_extra = is_overlap ? "" : " [NO OVERLAP]"
    table.cell(t, 0, 0, "NAS/DAX SPREAD", text_color=color.white, bgcolor=title_bg, text_size=sz_s)
    table.cell(t, 1, 0, title_extra,      text_color=color.new(#FF9800, 0), bgcolor=title_bg, text_size=sz_t)
    table.cell(t, 2, 0, action_text,      text_color=color.white, bgcolor=action_color, text_size=sz_n)

    // Row 1: Z-score
    table.cell(t, 0, 1, "Z-score",                          text_color=color.white, bgcolor=z_cell, text_size=sz_s)
    table.cell(t, 1, 1, str.tostring(dir_z, "#.##"),        text_color=color.white, bgcolor=z_cell, text_size=sz_n)
    table.cell(t, 2, 1, mom_text,                           text_color=color.white, bgcolor=z_cell, text_size=sz_s)

    // Row 2: Reversion (слабее чем NQ/ES!)
    table.cell(t, 0, 2, "Возврат",                          text_color=color.gray, bgcolor=inf_bg, text_size=sz_s)
    table.cell(t, 1, 2, rev_text + rev_detail,              text_color=abs_dz > 1.5 ? color.white : color.gray, bgcolor=inf_bg, text_size=sz_s)
    table.cell(t, 2, 2, rev_dir,                            text_color=color.gray, bgcolor=inf_bg, text_size=sz_t)

    // Row 3: Divergence
    table.cell(t, 0, 3, "Дивергенция",                      text_color=color.white, bgcolor=div_color, text_size=sz_s)
    table.cell(t, 1, 3, div_text,                            text_color=color.white, bgcolor=div_color, text_size=sz_s)
    table.cell(t, 2, 3, "",                                  bgcolor=div_color)

    // Row 4: Session overlap — КЛЮЧЕВОЕ для этой пары
    sess_bg = is_overlap ? color.new(#00C853, 40) : (is_dax_only or is_nq_only) ? color.new(#FF9800, 50) : color.new(#D32F2F, 50)
    table.cell(t, 0, 4, str.tostring(h_utc) + ":00 UTC",   text_color=color.white, bgcolor=sess_bg, text_size=sz_s)
    table.cell(t, 1, 4, liq_text,                           text_color=liq_color, bgcolor=sess_bg, text_size=sz_s)
    table.cell(t, 2, 4, is_overlap ? "13:30-16:30" : "",    text_color=color.new(color.white, 40), bgcolor=sess_bg, text_size=sz_t)

    // Row 5: ATR Ratio
    atr_bg = math.abs(atr_ratio_dev) > 15 ? color.new(#FF9800, 30) : color.new(#1565C0, 50)
    atr_txt = not na(atr_ratio) ? str.tostring(atr_ratio, "#.##") : "—"
    atr_detail = not na(nq_atr) and not na(dax_atr) ? "NAS:" + str.tostring(nq_atr, "#.#") + " DAX:" + str.tostring(dax_atr, "#.#") : ""
    atr_warn = math.abs(atr_ratio_dev) > 15 ? " !" : ""
    table.cell(t, 0, 5, "ATR Ratio",        text_color=color.white, bgcolor=atr_bg, text_size=sz_s)
    table.cell(t, 1, 5, atr_txt + atr_warn, text_color=color.white, bgcolor=atr_bg, text_size=sz_n)
    table.cell(t, 2, 5, atr_detail,         text_color=color.new(color.white, 30), bgcolor=atr_bg, text_size=sz_t)

    // Row 6: Volatility regime
    vol_text = vol_regime > 1.5 ? "ВЫСОКАЯ!" : vol_regime > 1.2 ? "ПОВЫШЕНА" : vol_regime < 0.7 ? "НИЗКАЯ" : "НОРМА"
    vol_bg = vol_regime > 1.5 ? color.new(#D32F2F, 30) : vol_regime > 1.2 ? color.new(#FF9800, 40) : vol_regime < 0.7 ? color.new(#2196F3, 40) : color.new(#4CAF50, 60)
    ratio_dev_txt = "Ratio " + (atr_ratio_dev >= 0 ? "+" : "") + str.tostring(atr_ratio_dev, "#.#") + "%"
    ratio_dev_c = math.abs(atr_ratio_dev) > 15 ? color.new(#FF9800, 0) : color.new(color.white, 30)
    table.cell(t, 0, 6, "Волатильн.",  text_color=color.white, bgcolor=vol_bg, text_size=sz_s)
    table.cell(t, 1, 6, vol_text,      text_color=color.white, bgcolor=vol_bg, text_size=sz_s)
    table.cell(t, 2, 6, ratio_dev_txt, text_color=ratio_dev_c, bgcolor=vol_bg, text_size=sz_t)

    // Row 7: Context separator
    table.cell(t, 0, 7, "── КОНТЕКСТ ──",                   text_color=color.gray, bgcolor=sec_bg, text_size=sz_t)
    table.cell(t, 1, 7, "",                                  bgcolor=sec_bg)
    table.cell(t, 2, 7, "",                                  bgcolor=sec_bg)

    // Row 8: Beta + drift + Correlation (ВАЖНО: если Corr < 0.5 — пара ненадёжна)
    corr_c = not na(corr_val) and corr_val < 0.5 ? color.new(#FF9800, 0) : color.gray
    table.cell(t, 0, 8, "β " + str.tostring(beta_use, "#.##"), text_color=color.gray, bgcolor=ctx_bg, text_size=sz_s)
    table.cell(t, 1, 8, "drift " + str.tostring(beta_drift_pct, "#.#") + "%", text_color=color.gray, bgcolor=ctx_bg, text_size=sz_t)
    table.cell(t, 2, 8, "Corr " + str.tostring(corr_val, "#.##"), text_color=corr_c, bgcolor=ctx_bg, text_size=sz_t)

    // Row 9: VIX + Ratio + Direction
    dir_short = my_dir == "Long NAS100 / Short GER40" ? "L·NAS / S·DAX" : "S·NAS / L·DAX"
    vix_bg = not na(vix) and vix > 35 ? color.new(#D32F2F, 20) : not na(vix) and vix > 25 ? color.new(#FF9800, 30) : not na(vix) and vix > 20 ? color.new(#FFC107, 50) : ctx_bg
    vix_tc = not na(vix) and vix > 20 ? color.white : color.gray
    table.cell(t, 0, 9, "VIX " + str.tostring(vix, "#.#"),  text_color=vix_tc, bgcolor=vix_bg, text_size=sz_s)
    table.cell(t, 1, 9, "Ratio Δ" + str.tostring(ratio_change_pct, "#.##") + "%", text_color=color.gray, bgcolor=vix_bg, text_size=sz_t)
    table.cell(t, 2, 9, dir_short,                           text_color=color.gray, bgcolor=vix_bg, text_size=sz_t)

// ============================================================
// ALERTS
// ============================================================
tp_cross       = ta.crossover(dir_z, z_tp)
urgent_tp      = ta.crossover(dir_z, 3.0)
dd_cross       = ta.crossunder(dir_z, z_dd)
was_in_dd      = ta.lowest(dir_z, 12) < -1.0
recovery_cross = ta.crossover(dir_z, 0.0) and was_in_dd

alertcondition(tp_cross,       "Z: Take Profit",  "NAS/DAX: z вошёл в зону TP — фиксация прибыли (95.8% откат за 4ч)")
alertcondition(urgent_tp,      "Z: URGENT TP!",   "NAS/DAX: z > 3.0 — ФИКСИРУЙ СЕЙЧАС (99.9% откат за 4ч)")
alertcondition(dd_cross,       "Z: Deep DD",      "NAS/DAX: z вошёл в зону DD — глубокая просадка")
alertcondition(recovery_cross, "Z: Recovery",      "NAS/DAX: z вернулся к 0 из просадки — восстановление завершено")

alertcondition(ta.crossover(dir_z, 0.0),  "Z: пересёк 0 ↑", "NAS/DAX: z-score пересёк 0 вверх — позиция в плюсе")
alertcondition(ta.crossunder(dir_z, 0.0), "Z: пересёк 0 ↓", "NAS/DAX: z-score пересёк 0 вниз — позиция в минусе")

div_flip_minus = divergence < 0 and divergence[1] >= 0
div_flip_plus  = divergence > 0 and divergence[1] <= 0
alertcondition(div_flip_minus, "Дивергенция: В МИНУС", "NAS/DAX: дивергенция перешла в минус")
alertcondition(div_flip_plus,  "Дивергенция: В ПЛЮС",  "NAS/DAX: дивергенция перешла в плюс")

// Volatility & sizing alerts
vol_spike    = vol_regime > 1.5 and vol_regime[1] <= 1.5
vol_norm     = vol_regime <= 1.2 and vol_regime[1] > 1.2
ratio_broken = math.abs(atr_ratio_dev) > 15 and math.abs(atr_ratio_dev[1]) <= 15

alertcondition(vol_spike,    "Вола: ВЫСОКАЯ!",        "NAS/DAX: волатильность 1.5x выше нормы — расширь стопы или уменьши лоты")
alertcondition(vol_norm,     "Вола: нормализация",    "NAS/DAX: волатильность вернулась к норме")
alertcondition(ratio_broken, "ATR Ratio: пересчёт!",  "NAS/DAX: ATR ratio сместился >15% от среднего — пересчитай лотаж")
